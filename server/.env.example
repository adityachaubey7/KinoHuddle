# Server
NODE_ENV=development
PORT=4000

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/syncspace

# Long random string used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Browser origin(s) allowed to call the API (comma-separated)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# Rooms expire after this many hours with no activity
ROOM_TTL_HOURS=24
# Seconds to wait before handing host to someone else when the host disconnects
HOST_GRACE_SECONDS=60

# Set to true when running behind a reverse proxy (Render, Railway, Nginx…)
TRUST_PROXY=false

# Free public rooms
OFFICIAL_ROOMS_ENABLED=true
PUBLIC_ROOM_CAPACITY=200

# ---------------------------------------------------------------------------
# Added in the upgrade (all optional; defaults work for local development)
# ---------------------------------------------------------------------------

# Public URL of the web app. Used for links inside emails. Defaults to the first CLIENT_ORIGIN.
APP_URL=http://localhost:5173

# Session cookie SameSite. Use "lax" when the web app and API share one origin (recommended, and the
# default in development). Use "none" ONLY when the API is on a different site, e.g. api.example.com
# (this is the default when NODE_ENV=production, which forces Secure cookies and relies on the CORS allow-list).
# COOKIE_SAMESITE=lax

# Structured JSON logs: debug | info | warn | error | silent
LOG_LEVEL=info

# How often the reminder scheduler looks for watch parties that are about to start (milliseconds, 0 disables)
SCHEDULER_INTERVAL_MS=30000

# Email (optional). Without it SyncSpace still works; password reset and email verification are switched off
# and the app says so instead of pretending to send mail.
#   EMAIL_PROVIDER=none   email features disabled (default)
#   EMAIL_PROVIDER=smtp   send through any SMTP server (Brevo, Mailgun, Amazon SES, Gmail app password, ...)
EMAIL_PROVIDER=none
EMAIL_FROM=SyncSpace <no-reply@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
