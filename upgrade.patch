+async function presentHistory(userId, docs) {
+  const access = await roomAccess(userId, [...new Set(docs.map((d) => d.lastRoomCode).filter(Boolean))]);
+  return docs.map((h) => ({
+    id: h._id.toString(),
+    videoId: h.videoId,
+    title: h.title,
+    lastPosition: h.lastPosition,
+    duration: h.duration,
+    progress: progressOf(h),
