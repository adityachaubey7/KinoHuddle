+name: CI
+
+on:
+  push:
+    branches: [main, master]
+  pull_request:
+
+jobs:
+  backend:
+    name: Backend tests
+    runs-on: ubuntu-latest
+    services:
+      mongo:
+        image: mongo:7
+        ports: ['27017:27017']
+        options: >-
+          --health-cmd "mongosh --quiet --eval 'db.runCommand({ping:1})'"
+          --health-interval 5s --health-timeout 5s --health-retries 10
+    env:
+      TEST_MONGODB_URI: mongodb://127.0.0.1:27017/syncspace_test
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+          cache-dependency-path: server/package-lock.json
+      - run: npm --prefix server ci
+      - run: npm --prefix server test
+
+  frontend:
+    name: Frontend lint and build
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+          cache-dependency-path: client/package-lock.json
+      - run: npm --prefix client ci
+      - run: npm --prefix client run lint
+      - run: npm --prefix client run build
+
+  e2e:
+    name: Browser journeys
+    runs-on: ubuntu-latest
+    needs: [backend, frontend]
+    services:
+      mongo:
+        image: mongo:7
+        ports: ['27017:27017']
+    env:
+      MONGODB_URI: mongodb://127.0.0.1:27017/syncspace_e2e
+      JWT_SECRET: ci-only-secret-ci-only-secret-ci-only-secret
+      OFFICIAL_ROOMS_ENABLED: 'false'
+      PORT: '4000'
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      - run: npm --prefix server ci && npm --prefix client ci
+      - run: npm --prefix client run build
+      - run: pip install playwright && python -m playwright install --with-deps chromium
+      - name: Start API and client
+        run: |
+          node server/src/index.js &
+          (cd client && npx vite preview --port 4173 --strictPort) &
+          npx --yes wait-on http://localhost:4000/api/ready http://localhost:4173
+      - run: python e2e/journey.py e2e/shots
+      - run: python e2e/features.py e2e/shots
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: e2e-screenshots
+          path: e2e/shots
